# JSV Market — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets to Git.

# Firebase Web App (safe for browser use)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging / Web Push — PUBLIC VAPID key / key pair value
VITE_FIREBASE_VAPID_KEY=

# Firebase Admin SDK — SERVER ONLY. Configure these as Vercel environment variables.
# Never prefix these with VITE_ and never expose FIREBASE_PRIVATE_KEY in browser code.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 — SERVER ONLY. Private KYB and payout-document storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jsv-market-private

# Google Maps Platform — SERVER ONLY.
# Enable Places API (New) and Geocoding API in the Google Cloud project.
GOOGLE_MAPS_API_KEY=

# OpenAI request routing — SERVER ONLY.
# If OPENAI_API_KEY is omitted, JSV Market falls back to deterministic classification/routing.
OPENAI_API_KEY=
OPENAI_ROUTING_MODEL=gpt-5.6-luna

# Network International Hosted Payment Page — SERVER ONLY.
NETWORK_INTERNATIONAL_ENVIRONMENT=sandbox
NETWORK_INTERNATIONAL_API_KEY=
NETWORK_INTERNATIONAL_OUTLET_REF=
NETWORK_INTERNATIONAL_WEBHOOK_TOKEN=
# Keep both false until the hosted preview payment journey is validated.
PAYMENTS_ENABLED=false
VITE_JSV_MARKET_CHECKOUT_ENABLED=false

# App
VITE_APP_NAME=JSV Market
VITE_APP_URL=http://localhost:5173
JSV_MARKET_APP_URL=https://preview.example.com
JSV_MARKET_WEBHOOK_SECRET=
