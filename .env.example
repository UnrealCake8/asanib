# Asanib — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets to Git.

# Firebase Web App (safe for browser use)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging / Web Push — PUBLIC VAPID key / key pair value
VITE_FIREBASE_VAPID_KEY=

# Firebase Admin SDK — SERVER ONLY. Configure these as Vercel environment variables.
# Never prefix these with VITE_ and never expose FIREBASE_PRIVATE_KEY in browser code.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 — SERVER ONLY. Private KYB document storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=asanib-private

# Google Maps Platform — SERVER ONLY.
# Enable Places API (New) and Geocoding API in the Google Cloud project.
GOOGLE_MAPS_API_KEY=

# Ziina Checkout — SERVER ONLY.
# Use the API token from the JS Ventures LLC Ziina Business account.
ZIINA_API_TOKEN=
ZIINA_WEBHOOK_SECRET=
# Keep true until live payment testing is complete.
ZIINA_TEST_MODE=true

# App
VITE_APP_NAME=Asanib
VITE_APP_URL=http://localhost:5173
