rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function ownsRequest(requestId) {
      return signedIn()
        && exists(/databases/$(database)/documents/requests/$(requestId))
        && get(/databases/$(database)/documents/requests/$(requestId)).data.customerId == request.auth.uid;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['customer', 'provider'];
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /pushRegistrations/{fid} {
        allow read, write: if false;
      }
    }

    match /providers/{providerId} {
      allow create: if signedIn()
        && request.auth.uid == providerId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.approved == false;
      allow read: if signedIn() && (request.auth.uid == providerId || isAdmin());
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == providerId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.approved == resource.data.approved);
      allow delete: if isAdmin();
    }

    match /providerMatches/{providerId}/requests/{requestId} {
      allow read: if signedIn() && (request.auth.uid == providerId || isAdmin());
      allow write: if false;
    }

    match /requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /quotes/{quoteId} {
      allow read: if signedIn()
        && (resource.data.providerId == request.auth.uid || ownsRequest(resource.data.requestId) || isAdmin());
      allow create, update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow create: if signedIn()
        && request.resource.data.bookingId == reviewId
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && exists(/databases/$(database)/documents/bookings/$(reviewId))
        && get(/databases/$(database)/documents/bookings/$(reviewId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(reviewId)).data.providerId == request.resource.data.providerId
        && get(/databases/$(database)/documents/bookings/$(reviewId)).data.requestId == request.resource.data.requestId
        && get(/databases/$(database)/documents/bookings/$(reviewId)).data.status == 'completed';
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid || isAdmin());
      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
      allow delete: if false;
    }

    match /externalProviders/{providerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /externalLeadDispatches/{dispatchId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappInboundEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
